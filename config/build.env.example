# Build-time public-client material. Native request encryption stays enabled on both frontends.
FCP_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e
FCP_REQUEST_PUBLIC_KEY=REPLACE_WITH_SPKI_DER_BASE64
# This is the native upstream response-decryption client key and will be in the browser bundle.
# It is NOT a server secret or an alternative to TLS.
FCP_RESPONSE_PRIVATE_KEY=REPLACE_WITH_PKCS8_DER_BASE64
