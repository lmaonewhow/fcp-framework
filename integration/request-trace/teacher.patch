+// Diagnostic scope stays in memory, never in request headers, URLs or serialized config.
+const traceScopes = new WeakMap<object, () => boolean>();
+let traceWatching = false;
+function traceIdentity(): string {
+  const auth = useAuthStore();
+  return JSON.stringify([localStg.get('token'), auth.token, auth.userInfo.user?.userId, auth.userInfo.user?.tenantId]);
+}
+function captureTraceScope(config: InternalAxiosRequestConfig): void {
+  if (!traceWatching) {
+    watch(traceIdentity, () => clearTraceNotice(), { flush: 'sync' });
+    traceWatching = true;
+  }
+  const identity = traceIdentity();
+  traceScopes.set(config, () => !config.signal?.aborted && traceIdentity() === identity);
+}
+function traceCurrent(config?: InternalAxiosRequestConfig): boolean {
+  return Boolean(config && traceScopes.get(config)?.());
+}
