+    <appender name="fcp_trace_file" class="ch.qos.logback.core.rolling.RollingFileAppender">
+        <file>${log.path}/fcp-request.log</file>
+        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
+            <fileNamePattern>${log.path}/fcp-request.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
+            <maxFileSize>32MB</maxFileSize><maxHistory>7</maxHistory><totalSizeCap>512MB</totalSizeCap>
+        </rollingPolicy>
+        <encoder><pattern>${log.pattern}</pattern><charset>utf-8</charset></encoder>
+    </appender>
+    <appender name="fcp_trace_async" class="org.dromara.fcp.observability.TraceAsyncAppender">
+        <queueSize>2048</queueSize><discardingThreshold>0</discardingThreshold><neverBlock>true</neverBlock>
+        <appender-ref ref="fcp_trace_file"/>
+    </appender>
+    <logger name="fcp.request" level="INFO" additivity="false"><appender-ref ref="fcp_trace_async"/></logger>
+    <logger name="fcp.audit" level="INFO" additivity="false"><appender-ref ref="fcp_trace_async"/></logger>
